# Netlify custom headers (copied into /dist by scripts/build.js)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Product photos, logos and hero images: cache for a year (file names are content-hashed
# or change rarely; a renamed upload gets a new URL).
/images/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# The admin must never be indexed or framed.
/admin/*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY

# The admin's catalogue snapshot changes every deploy; never cache it.
/admin/catalogue.json
  Cache-Control: no-store
